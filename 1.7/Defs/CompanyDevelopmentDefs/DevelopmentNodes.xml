<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <LCAnomalyStory.Defs.CompanyDevelopmentDef>
    <defName>LCStory_CompanyCharter</defName>
    <label>Company charter</label>
    <description>Establish the minimum operating authority required to begin abnormality extraction, containment, and Cogito handling.</description>
    <phase>0</phase>
    <displayOrder>0</displayOrder>
    <kind>Milestone</kind>
    <rewards>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_FinishResearch"><project>ExtractAbnormalityRiturals</project></li>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_FinishResearch"><project>CogitoUsages</project></li>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_FinishResearch"><project>LC_EntityContainment</project></li>
    </rewards>
  </LCAnomalyStory.Defs.CompanyDevelopmentDef>

  <LCAnomalyStory.Defs.CompanyDevelopmentDef>
    <defName>LCStory_Foundation</defName>
    <label>Establish containment operations</label>
    <description>Build a functioning containment platform and register the company's first abnormality.</description>
    <phase>1</phase>
    <displayOrder>10</displayOrder>
    <kind>Milestone</kind>
    <prerequisites>
      <li>LCStory_CompanyCharter</li>
    </prerequisites>
    <conditions>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_ThingCountAtLeast">
        <labelKey>LCStory_Condition_HoldingPlatform</labelKey>
        <thingDef>LC_HoldingPlatform</thingDef>
        <count>1</count>
      </li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_CoreAnomalyCountAtLeast">
        <labelKey>LCStory_Condition_AnomalyCount</labelKey>
        <count>1</count>
      </li>
    </conditions>
  </LCAnomalyStory.Defs.CompanyDevelopmentDef>

  <LCAnomalyStory.Defs.CompanyDevelopmentDef>
    <defName>LCStory_OperationalPractice</defName>
    <label>Build operational experience</label>
    <description>Demonstrate repeatable abnormality work, collect PE-Box output, and establish basic research knowledge.</description>
    <phase>1</phase>
    <displayOrder>20</displayOrder>
    <kind>DepartmentTask</kind>
    <department>LCStory_Control</department>
    <prerequisites>
      <li>LCStory_Foundation</li>
    </prerequisites>
    <conditions>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast">
        <labelKey>LCStory_Condition_ValidWorks</labelKey>
        <statistic>validWorks</statistic>
        <target>5</target>
        <sinceNodeActivation>true</sinceNodeActivation>
      </li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_AnyCoreStudyLevelAtLeast">
        <labelKey>LCStory_Condition_StudyLevel</labelKey>
        <level>2</level>
      </li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast">
        <labelKey>LCStory_Condition_PEBox</labelKey>
        <statistic>peBoxProduced</statistic>
        <target>20</target>
        <sinceNodeActivation>true</sinceNodeActivation>
      </li>
    </conditions>
  </LCAnomalyStory.Defs.CompanyDevelopmentDef>

  <LCAnomalyStory.Defs.CompanyDevelopmentDef>
    <defName>LCStory_BasicEnergyManagement</defName>
    <label>Authorize basic energy management</label>
    <description>Approve the company's first permanent energy-management capability after the operating requirements have been demonstrated.</description>
    <phase>1</phase>
    <displayOrder>30</displayOrder>
    <kind>StageGate</kind>
    <department>LCStory_Control</department>
    <prerequisites>
      <li>LCStory_OperationalPractice</li>
    </prerequisites>
    <conditions>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_ExaminationPassed">
        <labelKey>LCStory_Condition_Examination</labelKey>
        <examination>LCStory_LightContainmentInstability</examination>
      </li>
    </conditions>
    <rewards>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_FinishResearch">
        <project>ExtractEnkephalin</project>
      </li>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_OpenDepartment">
        <department>LCStory_Control</department>
      </li>
    </rewards>
  </LCAnomalyStory.Defs.CompanyDevelopmentDef>

  <LCAnomalyStory.Defs.CompanyDevelopmentDef>
    <defName>LCStory_InformationPractice</defName>
    <label>Information practice</label>
    <description>Prioritize information work, complete fresh directives, and deepen abnormality research.</description>
    <phase>2</phase>
    <displayOrder>40</displayOrder>
    <kind>DepartmentTask</kind>
    <department>LCStory_Information</department>
    <prerequisites><li>LCStory_BasicEnergyManagement</li></prerequisites>
    <conditions>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_DepartmentPrioritized"><department>LCStory_Information</department></li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_AnyCoreStudyLevelAtLeast"><level>3</level></li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast"><statistic>directivesCompleted</statistic><target>2</target><sinceNodeActivation>true</sinceNodeActivation></li>
    </conditions>
    <rewards>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_OpenDepartment"><department>LCStory_Information</department></li>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_FinishResearch"><project>Enkephalin_Drug</project></li>
    </rewards>
  </LCAnomalyStory.Defs.CompanyDevelopmentDef>

  <LCAnomalyStory.Defs.CompanyDevelopmentDef>
    <defName>LCStory_TrainingPractice</defName>
    <label>Training practice</label>
    <description>Prioritize training, sustain repeated work, and accumulate enough PE-Box to support material conversion.</description>
    <phase>2</phase>
    <displayOrder>50</displayOrder>
    <kind>DepartmentTask</kind>
    <department>LCStory_Training</department>
    <prerequisites><li>LCStory_BasicEnergyManagement</li></prerequisites>
    <conditions>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_DepartmentPrioritized"><department>LCStory_Training</department></li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast"><statistic>validWorks</statistic><target>10</target><sinceNodeActivation>true</sinceNodeActivation></li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast"><statistic>peBoxProduced</statistic><target>50</target><sinceNodeActivation>true</sinceNodeActivation></li>
    </conditions>
    <rewards>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_OpenDepartment"><department>LCStory_Training</department></li>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_FinishResearch"><project>EnkephalinConvert</project></li>
    </rewards>
  </LCAnomalyStory.Defs.CompanyDevelopmentDef>

  <LCAnomalyStory.Defs.CompanyDevelopmentDef>
    <defName>LCStory_OrganizationalIntegration</defName>
    <label>Organizational integration</label>
    <description>Integrate information and training practices into a stable production organization.</description>
    <phase>2</phase>
    <displayOrder>60</displayOrder>
    <kind>StageGate</kind>
    <prerequisites>
      <li>LCStory_InformationPractice</li>
      <li>LCStory_TrainingPractice</li>
    </prerequisites>
    <conditions>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast"><statistic>directivesCompleted</statistic><target>2</target><sinceNodeActivation>true</sinceNodeActivation></li>
    </conditions>
    <rewards>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_FinishResearch"><project>Enkephalin_ElectricGenerator</project></li>
    </rewards>
  </LCAnomalyStory.Defs.CompanyDevelopmentDef>

  <LCAnomalyStory.Defs.CompanyDevelopmentDef>
    <defName>LCStory_SecurityExpansion</defName>
    <label>Safety expansion</label>
    <description>Prioritize the Safety Team and demonstrate sustained work under expanded operating risk.</description>
    <phase>3</phase>
    <displayOrder>70</displayOrder>
    <kind>DepartmentTask</kind>
    <department>LCStory_Security</department>
    <prerequisites><li>LCStory_OrganizationalIntegration</li></prerequisites>
    <conditions>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_DepartmentPrioritized"><department>LCStory_Security</department></li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast"><statistic>validWorks</statistic><target>15</target><sinceNodeActivation>true</sinceNodeActivation></li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast"><statistic>directivesCompleted</statistic><target>3</target><sinceNodeActivation>true</sinceNodeActivation></li>
    </conditions>
    <rewards>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_OpenDepartment"><department>LCStory_Security</department></li>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_FinishResearch"><project>Enkephalin_ElectricGeneratorAdvanced</project></li>
    </rewards>
  </LCAnomalyStory.Defs.CompanyDevelopmentDef>

  <LCAnomalyStory.Defs.CompanyDevelopmentDef>
    <defName>LCStory_CentralCommandEstablishment</defName>
    <label>Central Command establishment</label>
    <description>Prioritize Central Command and establish coordinated mid-layer management across multiple containment sectors.</description>
    <phase>3</phase>
    <displayOrder>75</displayOrder>
    <kind>DepartmentTask</kind>
    <department>LCStory_CentralCommand</department>
    <prerequisites><li>LCStory_OrganizationalIntegration</li></prerequisites>
    <conditions>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_DepartmentPrioritized"><department>LCStory_CentralCommand</department></li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast"><labelKey>LCStory_Condition_ValidWorks</labelKey><statistic>validWorks</statistic><target>18</target><sinceNodeActivation>true</sinceNodeActivation></li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast"><labelKey>LCStory_Condition_PEBox</labelKey><statistic>peBoxProduced</statistic><target>80</target><sinceNodeActivation>true</sinceNodeActivation></li>
    </conditions>
    <rewards>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_OpenDepartment"><department>LCStory_CentralCommand</department></li>
    </rewards>
  </LCAnomalyStory.Defs.CompanyDevelopmentDef>

  <LCAnomalyStory.Defs.CompanyDevelopmentDef>
    <defName>LCStory_WelfareExpansion</defName>
    <label>Welfare expansion</label>
    <description>Prioritize welfare and prove that the company can sustain efficient production over time.</description>
    <phase>3</phase>
    <displayOrder>80</displayOrder>
    <kind>DepartmentTask</kind>
    <department>LCStory_Welfare</department>
    <prerequisites><li>LCStory_OrganizationalIntegration</li></prerequisites>
    <conditions>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_DepartmentPrioritized"><department>LCStory_Welfare</department></li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast"><statistic>peBoxProduced</statistic><target>100</target><sinceNodeActivation>true</sinceNodeActivation></li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast"><statistic>directivesCompleted</statistic><target>3</target><sinceNodeActivation>true</sinceNodeActivation></li>
    </conditions>
    <rewards>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_OpenDepartment"><department>LCStory_Welfare</department></li>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_FinishResearch"><project>Enkephalin_ElectricGeneratorECO</project></li>
    </rewards>
  </LCAnomalyStory.Defs.CompanyDevelopmentDef>

  <LCAnomalyStory.Defs.CompanyDevelopmentDef>
    <defName>LCStory_DisciplinaryDoctrine</defName>
    <label>Disciplinary doctrine</label>
    <description>Prioritize the Disciplinary Team, forge E.G.O armaments, and establish an aggressive suppression armory.</description>
    <phase>4</phase>
    <displayOrder>85</displayOrder>
    <kind>DepartmentTask</kind>
    <department>LCStory_Disciplinary</department>
    <prerequisites><li>LCStory_OrganizationalIntegration</li></prerequisites>
    <conditions>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_DepartmentPrioritized"><department>LCStory_Disciplinary</department></li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_AnyNodeCompleted">
        <nodes><li>LCStory_SecurityExpansion</li><li>LCStory_CentralCommandEstablishment</li><li>LCStory_WelfareExpansion</li></nodes>
      </li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast"><labelKey>LCStory_Condition_EgoExtracted</labelKey><statistic>egoExtracted</statistic><target>1</target><sinceNodeActivation>true</sinceNodeActivation></li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast"><labelKey>LCStory_Condition_ValidWorks</labelKey><statistic>validWorks</statistic><target>20</target><sinceNodeActivation>true</sinceNodeActivation></li>
    </conditions>
    <rewards>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_OpenDepartment"><department>LCStory_Disciplinary</department></li>
    </rewards>
  </LCAnomalyStory.Defs.CompanyDevelopmentDef>

  <LCAnomalyStory.Defs.CompanyDevelopmentDef>
    <defName>LCStory_RecordPreservation</defName>
    <label>Record preservation</label>
    <description>Prioritize the Record Team and prove consistent high-quality operations across repeated work cycles.</description>
    <phase>4</phase>
    <displayOrder>88</displayOrder>
    <kind>DepartmentTask</kind>
    <department>LCStory_Record</department>
    <prerequisites><li>LCStory_OrganizationalIntegration</li></prerequisites>
    <conditions>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_DepartmentPrioritized"><department>LCStory_Record</department></li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_AnyNodeCompleted">
        <nodes><li>LCStory_SecurityExpansion</li><li>LCStory_CentralCommandEstablishment</li><li>LCStory_WelfareExpansion</li></nodes>
      </li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast"><labelKey>LCStory_Condition_GoodWorks</labelKey><statistic>goodWorks</statistic><target>10</target><sinceNodeActivation>true</sinceNodeActivation></li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast"><statistic>directivesCompleted</statistic><target>3</target><sinceNodeActivation>true</sinceNodeActivation></li>
    </conditions>
    <rewards>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_OpenDepartment"><department>LCStory_Record</department></li>
    </rewards>
  </LCAnomalyStory.Defs.CompanyDevelopmentDef>

  <LCAnomalyStory.Defs.CompanyDevelopmentDef>
    <defName>LCStory_InstitutionalCrisis</defName>
    <label>Institutional crisis</label>
    <description>Consolidate a high-risk operating doctrine after completing at least one advanced department route.</description>
    <phase>4</phase>
    <displayOrder>90</displayOrder>
    <kind>StageGate</kind>
    <department>LCStory_Extraction</department>
    <prerequisites><li>LCStory_OrganizationalIntegration</li></prerequisites>
    <conditions>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_AnyNodeCompleted">
        <nodes><li>LCStory_SecurityExpansion</li><li>LCStory_CentralCommandEstablishment</li><li>LCStory_WelfareExpansion</li></nodes>
      </li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast"><statistic>directivesCompleted</statistic><target>5</target><sinceNodeActivation>true</sinceNodeActivation></li>
    </conditions>
    <rewards>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_OpenDepartment"><department>LCStory_Extraction</department></li>
    </rewards>
  </LCAnomalyStory.Defs.CompanyDevelopmentDef>

  <LCAnomalyStory.Defs.CompanyDevelopmentDef>
    <defName>LCStory_CorporateEndgame</defName>
    <label>Corporate endgame</label>
    <description>Establish the architecture required for terminal company projects and future narrative endings.</description>
    <phase>5</phase>
    <displayOrder>100</displayOrder>
    <kind>Milestone</kind>
    <department>LCStory_Architecture</department>
    <prerequisites><li>LCStory_InstitutionalCrisis</li></prerequisites>
    <conditions>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast"><statistic>validWorks</statistic><target>100</target><sinceNodeActivation>true</sinceNodeActivation></li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_StatisticAtLeast"><statistic>peBoxProduced</statistic><target>500</target><sinceNodeActivation>true</sinceNodeActivation></li>
      <li Class="LCAnomalyStory.Conditions.DevelopmentCondition_AnyCoreStudyLevelAtLeast"><level>4</level></li>
    </conditions>
    <rewards>
      <li Class="LCAnomalyStory.Rewards.DevelopmentReward_OpenDepartment"><department>LCStory_Architecture</department></li>
    </rewards>
  </LCAnomalyStory.Defs.CompanyDevelopmentDef>
</Defs>
