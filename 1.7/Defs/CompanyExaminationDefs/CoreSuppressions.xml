<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 1. Control Team Core Suppression (Malkuth) -->
  <LCAnomalyStory.Defs.CompanyExaminationDef>
    <defName>LCStory_CoreSuppression_Malkuth</defName>
    <label>Control Core Suppression — The Will to Stand Up Straight</label>
    <description>Control Team protocols scramble under severe cognitive pressure (-15% work success rate and periodic stress pulses). Complete eight valid abnormality works and produce thirty-five PE-Box before the suppression window ends.</description>
    <durationTicks>75000</durationTicks>
    <retryCooldownTicks>45000</retryCooldownTicks>
    <workerTickInterval>60</workerTickInterval>
    <effects>
      <li Class="LCAnomalyStory.Examinations.ExaminationEffect_WorkSuccessPenalty">
        <amount>0.15</amount>
      </li>
      <li Class="LCAnomalyStory.Examinations.ExaminationEffect_MentalStressPulse">
        <intervalTicks>4000</intervalTicks>
        <severity>0.04</severity>
      </li>
    </effects>
    <objectives>
      <li Class="LCAnomalyStory.Defs.ExaminationObjective_Statistic">
        <labelKey>LCStory_Condition_ValidWorks</labelKey>
        <statistic>validWorks</statistic>
        <target>8</target>
      </li>
      <li Class="LCAnomalyStory.Defs.ExaminationObjective_Statistic">
        <labelKey>LCStory_Condition_PEBox</labelKey>
        <statistic>peBoxProduced</statistic>
        <target>35</target>
      </li>
    </objectives>
  </LCAnomalyStory.Defs.CompanyExaminationDef>

