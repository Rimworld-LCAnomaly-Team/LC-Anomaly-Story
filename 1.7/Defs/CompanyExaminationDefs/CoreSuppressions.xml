    <durationTicks>90000</durationTicks>
    <retryCooldownTicks>45000</retryCooldownTicks>
    <workerTickInterval>60</workerTickInterval>
    <effects>
      <li Class="LCAnomalyStory.Examinations.ExaminationEffect_ColonistHediff">
