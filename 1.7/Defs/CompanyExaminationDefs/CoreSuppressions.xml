      </li>
    </effects>
    <objectives>
      <li Class="LCAnomalyStory.Defs.ExaminationObjective_Statistic">
        <labelKey>LCStory_Condition_ValidWorks</labelKey>
        <statistic>validWorks</statistic>
        <target>10</target>
      </li>
    </objectives>
  </LCAnomalyStory.Defs.CompanyExaminationDef>

