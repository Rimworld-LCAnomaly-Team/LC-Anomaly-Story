<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <LCAnomalyStory.Defs.CompanyDirectiveDef>
    <defName>LCStory_Directive_ControlledWorkCycle</defName>
    <label>Controlled work cycle</label>
    <description>Complete three valid abnormality work sessions before the directive expires.</description>
    <minimumPhase>1</minimumPhase>
    <department>LCStory_Control</department>
    <durationTicks>60000</durationTicks>
    <cooldownTicks>30000</cooldownTicks>
    <selectionWeight>1</selectionWeight>
    <departmentExperience>1</departmentExperience>
    <objectives>
      <li Class="LCAnomalyStory.Defs.DirectiveObjective_Statistic">
        <labelKey>LCStory_Condition_ValidWorks</labelKey>
        <statistic>validWorks</statistic>
        <target>3</target>
      </li>
    </objectives>
  </LCAnomalyStory.Defs.CompanyDirectiveDef>
  <LCAnomalyStory.Defs.CompanyDirectiveDef>
    <defName>LCStory_Directive_PEBoxQuota</defName>
    <label>PE-Box quota</label>
    <description>Produce twelve PE-Box before the directive expires.</description>
    <minimumPhase>1</minimumPhase>
    <department>LCStory_Control</department>
    <durationTicks>60000</durationTicks>
    <cooldownTicks>30000</cooldownTicks>
    <selectionWeight>1</selectionWeight>
    <departmentExperience>1</departmentExperience>
    <objectives>
      <li Class="LCAnomalyStory.Defs.DirectiveObjective_Statistic">
        <labelKey>LCStory_Condition_PEBox</labelKey>
        <statistic>peBoxProduced</statistic>
        <target>12</target>
      </li>
    </objectives>
  </LCAnomalyStory.Defs.CompanyDirectiveDef>
</Defs>
