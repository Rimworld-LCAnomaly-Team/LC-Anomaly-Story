<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <LCAnomalyStory.Defs.CompanyExaminationDef>
    <defName>LCStory_LightContainmentInstability</defName>
    <label>Light containment instability</label>
    <description>Containment procedures become less reliable for one day. Complete three valid work sessions and produce ten PE-Box before the assessment ends.</description>
    <durationTicks>60000</durationTicks>
    <retryCooldownTicks>30000</retryCooldownTicks>
    <workerTickInterval>60</workerTickInterval>
    <effects>
      <li Class="LCAnomalyStory.Examinations.ExaminationEffect_WorkSuccessPenalty">
        <amount>0.10</amount>
      </li>
    </effects>
    <objectives>
      <li Class="LCAnomalyStory.Defs.ExaminationObjective_Statistic">
        <labelKey>LCStory_Condition_ValidWorks</labelKey>
        <statistic>validWorks</statistic>
        <target>3</target>
      </li>
      <li Class="LCAnomalyStory.Defs.ExaminationObjective_Statistic">
        <labelKey>LCStory_Condition_PEBox</labelKey>
        <statistic>peBoxProduced</statistic>
        <target>10</target>
      </li>
    </objectives>
  </LCAnomalyStory.Defs.CompanyExaminationDef>
</Defs>
